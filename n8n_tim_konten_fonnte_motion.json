      "parameters": {
        "promptType": "define",
        "text": "=Buatkan JSON 5 scene video motion 9:16 untuk konten berikut:\nID_Konten: {{ $json.ID_Konten }}\nPilar: {{ $json.Pilar }}\nTopik: {{ $json.Topik }}\nHook: {{ $json.Hook_3_Detik }}\nNaskah: {{ $json.Naskah_Lengkap }}\nPrompt Visual Dasar: {{ $json.Prompt_Visual }}",
        "options": {
          "systemMessage": "Kamu adalah Sutradara Video Motion 9:16 (1080x1920, durasi ~23 detik). Kembalikan HANYA JSON valid tanpa markdown ```json:\n{\n  \"id_konten\": \"...\",\n  \"voiceover_full\": \"Narasi Bahasa Indonesia lengkap ~55 kata, alami dan hangat\",\n  \"scenes\": [\n    {\"scene_no\": 1, \"duration\": 3, \"text\": \"Hook max 7 kata\", \"bg_color\": \"#1F4E5F\", \"text_color\": \"#FFFFFF\"},\n    {\"scene_no\": 2, \"duration\": 5, \"text\": \"Poin 1 max 8 kata\", \"bg_color\": \"#264653\", \"text_color\": \"#FFFFFF\"},\n    {\"scene_no\": 3, \"duration\": 6, \"text\": \"Poin 2 max 8 kata\", \"bg_color\": \"#2A9D8F\", \"text_color\": \"#FFFFFF\"},\n    {\"scene_no\": 4, \"duration\": 5, \"text\": \"Poin 3 max 8 kata\", \"bg_color\": \"#1F4E5F\", \"text_color\": \"#FFFFFF\"},\n    {\"scene_no\": 5, \"duration\": 4, \"text\": \"CTA Chat WA Sekarang\", \"bg_color\": \"#E76F51\", \"text_color\": \"#FFFFFF\"}\n  ]\n}"
        }
      },
      "id": "ai-motion-director",
      "name": "AI Sutradara Video Motion",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
