    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.text || '{}';\nconst clean = raw.replace(/```json|```/g, '').trim();\nconst parsed = JSON.parse(clean);\n\nconst scenes = (parsed.scenes || []).map((s) => ({\n  comment: `Scene ${s.scene_no}`,\n  duration: s.duration || 4,\n  'background-color': s.bg_color || '#1F4E5F',\n  transition: { style: 'fade', duration: 0.4 },\n  elements: [\n    {\n      type: 'text',\n      text: s.text,\n      style: '003',\n      settings: {\n        'font-family': 'Montserrat',\n        'font-size': '64px',\n        'font-color': s.text_color || '#FFFFFF'\n      },\n      position: 'center-center'\n    }\n  ]\n}));\n\nreturn [{\n  json: {\n    id_konten: parsed.id_konten,\n    payload: {\n      resolution: 'instagram-story',\n      quality: 'high',\n      draft: false,\n      scenes,\n      elements: [\n        {\n          type: 'voice',\n          text: parsed.voiceover_full,\n          model: 'azure'\n        },\n        {\n          type: 'subtitles',\n          settings: {\n            style: 'classic',\n            'font-family': 'Montserrat',\n            'font-size': '44px',\n            position: 'bottom-center'\n          }\n        }\n      ]\n    }\n  }\n}];"
      },
      "id": "susun-payload-motion",
      "name": "Susun Payload JSON2Video",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
