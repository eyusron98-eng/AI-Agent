              "id": "cond-not-empty",
              "leftValue": "={{ $json.body.message || $json.message || '' }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            },
            {
              "id": "cond-prefix-ai",
              "leftValue": "={{ ($json.body.message || $json.message || '').trim() }}",
              "rightValue": "/ai",
              "operator": {
                "type": "string",
                "operation": "startsWith"
              }
            },
